OPENRAG_PROFILE=lite
OPENRAG_SERVICE_NAME=openrag-forge-api
OPENRAG_SERVICE_ENV=dev
OPENRAG_LOG_LEVEL=INFO
OPENRAG_ENABLE_REQUEST_LOG=true
OPENRAG_TRACE_SAMPLE_RATE=1.0
OPENRAG_CORS_ALLOW_ORIGINS=*
OPENRAG_DATA_DIR=./data
OPENRAG_QDRANT_URL=http://localhost:6333
OPENRAG_QDRANT_COLLECTION=openrag_forge
OPENRAG_CHAT_BASE_URL=http://localhost:1234/v1
OPENRAG_EMBEDDING_BASE_URL=http://localhost:1234/v1
OPENRAG_RERANKER_BASE_URL=
OPENRAG_CHAT_MODEL=local-chat-model
OPENRAG_EMBEDDING_MODEL=local-embedding-model
OPENRAG_RERANKER_MODEL=
OPENRAG_MAX_UPLOAD_MB=64
OPENRAG_DEFAULT_TOP_K=5
OPENRAG_CHUNK_MAX_CHARS=1200
OPENRAG_CHUNK_OVERLAP=120
OPENRAG_RETRIEVAL_SCORE_THRESHOLD=0.5
OPENRAG_TRACE_PERSISTENCE=true

