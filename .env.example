# =============================================================================
# OpenRAG Forge 配置模板 —— 复制为 .env 后按需修改
#
# 配置在哪里生效（按部署方式）：
#   本地开发        -> 本文件（.env，已被 .gitignore 排除，不会被提交）
#   Docker Compose  -> docker-compose.yml 的 environment: 块
#   Kubernetes      -> deploy/k8s/configmap.yaml（非敏感）+ Secret（敏感项）
#
# 每一项的详细解释与生产建议见 docs/configuration.md
# =============================================================================

# ---- 运行档位 ----------------------------------------------------------------
# environment=production 时会启用生产就绪检查（结果见 /api/v1/health）
OPENRAG_PROFILE=lite
OPENRAG_ENVIRONMENT=dev
OPENRAG_HOST=127.0.0.1
OPENRAG_PORT=18000
OPENRAG_GRACEFUL_SHUTDOWN_SECONDS=30

# ---- 真相源存储（生产环境必须挂载持久卷）--------------------------------------
OPENRAG_DATA_DIR=./data

# ---- 派生索引 Qdrant ----------------------------------------------------------
OPENRAG_QDRANT_URL=http://localhost:6333
OPENRAG_QDRANT_COLLECTION=openrag_forge
# Qdrant Cloud / 鉴权集群的 key；生产环境用 Secret 注入，不要提交到仓库
OPENRAG_QDRANT_API_KEY=

# ---- 模型端点（OpenAI 兼容：LM Studio / vLLM / llama.cpp / 云端）---------------
OPENRAG_CHAT_BASE_URL=http://localhost:1234/v1
OPENRAG_EMBEDDING_BASE_URL=http://localhost:1234/v1
OPENRAG_RERANKER_BASE_URL=
OPENRAG_CHAT_MODEL=local-chat-model
OPENRAG_EMBEDDING_MODEL=local-embedding-model
OPENRAG_RERANKER_MODEL=
# 全局模型 Bearer token（本地 LM Studio 留空即可）；也可在工作台按模型单独注册 key
OPENRAG_MODEL_API_KEY=
# 可选：按类型分别注入（覆盖 model_api_key）；也可在工作台「导入 API / 模型」里按模型注册
OPENRAG_CHAT_API_KEY=
OPENRAG_EMBEDDING_API_KEY=
OPENRAG_RERANKER_API_KEY=

# ---- 出站超时（秒）：按下游 P99 延迟 + 余量设定 --------------------------------
OPENRAG_HTTP_TIMEOUT_SECONDS=10
OPENRAG_PROBE_TIMEOUT_SECONDS=2
OPENRAG_EMBEDDING_TIMEOUT_SECONDS=60
OPENRAG_CHAT_TIMEOUT_SECONDS=90
OPENRAG_INDEX_TIMEOUT_SECONDS=120

# ---- 安全 ---------------------------------------------------------------------
# 生产环境三件事：列出确切 CORS 域名、设置 API key、开启限流（或在网关限流）
OPENRAG_CORS_ALLOW_ORIGINS=*
OPENRAG_API_KEY=
OPENRAG_RATE_LIMIT_PER_MINUTE=0
OPENRAG_MAX_UPLOAD_MB=64

# ---- 可观测性（详见 docs/observability.md）------------------------------------
# 生产建议：log_format=json + otel_enabled=true + 采样率按流量调整
OPENRAG_LOG_LEVEL=info
OPENRAG_LOG_FORMAT=text
OPENRAG_OTEL_ENABLED=false
OPENRAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OPENRAG_OTEL_SERVICE_NAME=openrag-forge
OPENRAG_OTEL_SAMPLE_RATIO=1.0
OPENRAG_METRICS_ENABLED=true

# ---- 检索与业务 Trace ----------------------------------------------------------
OPENRAG_RETRIEVAL_SCORE_THRESHOLD=0.5
OPENRAG_TRACE_PERSISTENCE=true
